<?xml version="1.0" encoding="utf-8"?>
<Mod id="bz-trails" version="1.0.0" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_BZ_TRAILS_NAME</Name>
        <Version>1.0.0</Version>
        <Description>LOC_MOD_BZ_TRAILS_DESCRIPTION</Description>
        <Authors>beezany</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
        <Criteria id="bz-age-antiquity">
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="bz-age-exploration">
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="bz-age-modern">
            <AgeInUse>AGE_MODERN</AgeInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="bz-trails-always" scope="game" criteria="always">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-trails-always.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-trails-antiquity" scope="game" criteria="bz-age-antiquity">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-trails-antiquity.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-trails-exploration" scope="game" criteria="bz-age-exploration">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-trails-exploration.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
        <ActionGroup id="bz-trails-modern" scope="game" criteria="bz-age-modern">
            <Properties>
                <LoadOrder>10000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateDatabase>
                    <Item>data/bz-trails-modern.sql</Item>
                </UpdateDatabase>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
